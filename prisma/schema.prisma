generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AdminUser {
  id        String        @id @default(cuid())
  auth0Sub  String        @unique
  email     String        @unique
  name      String?
  role      Role          @default(VIEWER)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  articles  Article[]     @relation("ArticleAuthor")

  @@map("admin_user")
}

model Provider {
  id            String        @id @default(cuid())
  slug          String        @unique
  displayName   String
  credentials   String
  specialty     String
  languages     String[]
  bio           String        @db.Text
  photoUrl      String?
  location      String
  acceptingNew  Boolean       @default(true)
  status        PublishStatus @default(DRAFT)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, sortOrder])
  @@map("provider")
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  category       String
  excerpt        String
  bodyJson       Json
  authorSlug     String?
  readingMinutes Int           @default(5)
  featured       Boolean       @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  authorId       String?
  author         AdminUser?    @relation("ArticleAuthor", fields: [authorId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("article")
}

model Service {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  sortOrder   Int           @default(0)
  status      PublishStatus @default(PUBLISHED)

  @@map("service")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  subject   String?
  message   String   @db.Text
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_submission")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorSub  String
  actorEmail String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_log")
}
