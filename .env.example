# Canonical public site URL
NEXT_PUBLIC_SITE_URL=https://lumina-health-wellness.com

# Auth0 (Regular Web Application)
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://lumina-health-wellness.com/api
AUTH0_SCOPE=openid profile email
AUTH0_ROLES_CLAIM=https://lumina-health-wellness.com/roles

# PostgreSQL (use a pooled URL for runtime, unpooled for migrations)
DATABASE_URL=postgresql://user:password@host/db?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@host/db

# First administrator (create after signing in once)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_AUTH0_SUB=

# Shared secret for the /api/revalidate endpoint
REVALIDATE_SECRET=

# Contact form email delivery (Resend)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Lumina Website <onboarding@resend.dev>
RESEND_API_KEY=
