# Sanity CMS (optional — omit to serve bundled content from src/content)
NEXT_PUBLIC_SANITY_PROJECT_ID=texvu9pc
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only: read token for draft/preview reads (optional)
SANITY_API_READ_TOKEN=your_sanity_read_token

# Server-only: write token used by `npm run seed` (Editor role, optional if logged in via `sanity login`)
SANITY_API_WRITE_TOKEN=your_sanity_write_token

# Secret shared with the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=your_random_revalidate_secret

# Optional CRM webhook for contact form submissions
CRM_WEBHOOK_URL=
